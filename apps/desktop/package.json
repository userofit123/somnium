{
  "name": "somnium-desktop",
  "version": "0.1.0",
  "productName": "Somnium",
  "description": "Somnium lucid dreaming journal",
  "author": "Somnium",
  "homepage": "https://github.com/userofit123/somnium",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.15",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@somnium/engine": "workspace:*",
    "@somnium/server": "workspace:*",
    "@somnium/shared": "workspace:*",
    "@types/node": "22.10.2",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.2",
    "typescript": "5.7.2"
  },
  "build": {
    "appId": "org.somnium.app",
    "productName": "Somnium",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "userofit123",
      "repo": "somnium",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "Somnium",
      "icon": "assets/icon.png",
      "artifactName": "Somnium-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Somnium-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.lifestyle"
    }
  }
}
