<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nothing of the app is copied by Android's own backup (cloud or device-to-device): the journal's backups are
         Somnium's (Documents/Somnium), and the phone's keys must stay on it. allowBackup covers cloud backup up to
         Android 11, fullBackupContent says the same to Android 6-11, dataExtractionRules to 12+ (where allowBackup
         alone still lets a device-to-device copy through). Plain http is never allowed (network_security_config.xml
         says why, and what a server on the home network needs instead). requestLegacyExternalStorage: Android 10 lets
         the backups into Documents/Somnium with the storage permission below; later versions ignore it. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- adjustResize: the page runs behind the system bars (SomniumBarsPlugin), which then lifts it above the keyboard itself -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- reminders (SomniumRemindersPlugin): an alarm come due, a check logged from a notification's button, and the
             alarms set again after a restart, an update, a changed clock or exact alarms switched back on -->
        <receiver android:name=".SomniumRemindersPlugin$Fire" android:exported="false" />
        <receiver android:name=".SomniumRemindersPlugin$Action" android:exported="false" />
        <receiver android:name=".SomniumRemindersPlugin$Boot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- whether the connection is metered, for updates' "Only on Wi-Fi" (granted without asking) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- reminders (reality checks, bedtime, morning), on time even when the phone sleeps -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- exact alarms: Android 12 grants this one (it can be switched off, Settings → Notifications says so); from 13 on
         USE_EXACT_ALARM, which a sideloaded alarm-and-reminder app may hold without asking -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- the reminders' alarms are set again after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the alarm reminders' vibration before Android 8 (later the channel's setting) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- comes with @capacitor/local-notifications (here only for asking the notification permission) in its own
         manifest; Somnium's reminders never hold the phone awake themselves. Declared so it is on the list. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- backups into Documents/Somnium up to Android 10 (the Filesystem plugin asks for it there); from Android 11 an
         app writes its own files in Documents without any permission -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- installing updates downloaded from GitHub (sideloaded app; not for a Play Store build) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
