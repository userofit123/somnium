<?xml version="1.0" encoding="utf-8"?>
<!-- Only the app's cache, where a downloaded update waits for Android's installer (SomniumUpdaterPlugin.install):
     nothing else of the phone's storage can be handed to another app through this provider -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="." />
</paths>
