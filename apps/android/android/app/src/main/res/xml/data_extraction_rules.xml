<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules): no cloud backup and no device-to-device transfer of the app's data (see
     backup_rules.xml for why) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
