{
  "appId": "org.somnium.app",
  "appName": "Somnium",
  "webDir": "www",
  "loggingBehavior": "none",
  "android": {
    "backgroundColor": "#141233",
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_somnium",
      "iconColor": "#a99cff"
    }
  }
}
