# Copy to .env and change the password.
DB_PASSWORD=change-me-to-a-long-random-password
# Image version: latest follows every release (and Watchtower); a number such as 0.1.0 pins it.
# SOMNIUM_VERSION=latest
# SOMNIUM_PORT=8800
# Number of reverse proxies in front (default 1); see docs/self-hosting.md before changing.
# TRUST_PROXY=1
